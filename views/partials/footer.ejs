<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="brand">LE HIEP <span>STUDIO</span></span>
      <p><%= studio.tagline %> · <%= studio.location %></p>
    </div>

    <div class="footer-links">
      <a href="tel:<%= studio.phone %>"><%= studio.phone %></a>
      <a href="<%= studio.zaloUrl %>" target="_blank" rel="noopener">Zalo</a>
      <a href="<%= studio.facebookUrl %>" target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; <%= new Date().getFullYear() %> Le Hiep Studio. All rights reserved.</p>
  </div>
</footer>

<div class="care-widget" id="care-widget">
  <div class="care-panel" id="care-panel" hidden>
    <a class="care-option" href="<%= studio.zaloUrl %>" target="_blank" rel="noopener">
      <span class="care-option-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 2C6.48 2 2 5.94 2 10.8c0 2.77 1.47 5.24 3.77 6.86-.12.9-.45 2.19-1.27 3.32 0 0 1.9-.15 3.9-1.53.98.28 2.03.43 3.6.43 5.52 0 10-3.94 10-8.8C22 5.94 17.52 2 12 2z" fill="currentColor"/>
        </svg>
      </span>
      <span>Nhắn Zalo</span>
    </a>

    <a class="care-option" href="<%= studio.facebookUrl %>" target="_blank" rel="noopener">
      <span class="care-option-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14 9h2.5V6H14c-2.21 0-4 1.79-4 4v2H8v3h2v6h3v-6h2.5l.5-3H13v-2c0-.55.45-1 1-1z" fill="currentColor"/>
        </svg>
      </span>
      <span>Nhắn Facebook</span>
    </a>

    <% if (typeof aiChatEnabled !== 'undefined' && aiChatEnabled) { %>
    <button type="button" class="care-option" id="care-ai-btn">
      <span class="care-option-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l1.5 3.5L17 8l-3.5 1.5L12 13l-1.5-3.5L7 8l3.5-1.5L12 3z"/>
          <path d="M19 14l.8 1.8L21.5 16.5l-1.7.8-.8 1.7-.8-1.7-1.7-.8 1.7-.8L19 14z"/>
        </svg>
      </span>
      <span>Chat với AI tư vấn</span>
    </button>
    <% } %>
  </div>

  <button type="button" class="care-fab" id="care-fab" aria-expanded="false" aria-label="Mở chăm sóc khách hàng">
    <svg class="care-fab-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <svg class="care-fab-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  </button>
</div>

<% if (typeof aiChatEnabled !== 'undefined' && aiChatEnabled) { %>
<div class="ai-chat-panel" id="ai-chat-panel" hidden>
  <div class="ai-chat-header">
    <span>Trợ lý AI · <%= studio.name %></span>
    <button type="button" id="ai-chat-close" aria-label="Đóng khung chat">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="ai-chat-log" id="ai-chat-log">
    <div class="chat-bubble chat-bubble-assistant">Chào bạn! Mình là trợ lý tư vấn của <%= studio.name %>. Bạn đang quan tâm chụp ảnh theo phong cách nào ạ?</div>
  </div>
  <form class="ai-chat-form" id="ai-chat-form">
    <input type="text" id="ai-chat-input" placeholder="Nhập tin nhắn..." autocomplete="off" maxlength="1000">
    <button type="submit" class="ai-chat-send" aria-label="Gửi tin nhắn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
    </button>
  </form>
</div>
<% } %>
