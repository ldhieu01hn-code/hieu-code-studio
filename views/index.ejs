<!DOCTYPE html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body id="top">

<%- include('partials/nav') %>

<main>
  <!-- HERO -->
  <section class="hero">
    <img class="hero-bg" src="/images/hero.jpg" alt="" loading="eager" width="1365" height="2048">
    <div class="hero-scrim"></div>
    <div class="container hero-content">
      <p class="eyebrow reveal">Studio nhiếp ảnh nghệ thuật · Hà Nội</p>
      <h1 class="hero-title reveal">LE HIEP STUDIO</h1>
      <p class="hero-sub reveal">Nghệ thuật kể chuyện bằng ánh sáng, sắc màu và những khung hình mang đậm dấu ấn văn hoá Việt.</p>
      <div class="hero-actions reveal">
        <a href="#contact" class="btn btn-primary">Đặt lịch chụp</a>
        <a href="<%= studio.zaloUrl %>" target="_blank" rel="noopener" class="btn btn-outline">Nhắn Zalo ngay</a>
      </div>
    </div>
    <a href="#about" class="scroll-cue" aria-label="Cuộn xuống">
      <span></span>
    </a>
  </section>

  <!-- TRUST BAR -->
  <section class="trust-bar">
    <div class="container trust-inner">
      <div class="trust-item reveal">
        <strong><%= studio.followers %></strong>
        <span>người theo dõi trên Facebook</span>
      </div>
      <div class="trust-item reveal">
        <strong><%= studio.location %></strong>
        <span>và các vùng lân cận</span>
      </div>
      <div class="trust-item reveal">
        <strong><%= studio.phone %></strong>
        <span>hotline / Zalo đặt lịch</span>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about" id="about">
    <div class="container about-grid">
      <div class="about-media reveal">
        <img src="/images/about.jpg" alt="Le Hiep Studio - chụp ảnh nghệ thuật bên Hồ Gươm, Hà Nội" loading="lazy" width="2048" height="1365">
      </div>
      <div class="about-copy reveal">
        <p class="eyebrow">Giới thiệu</p>
        <h2>Nhiếp ảnh không chỉ<br>để ghi lại, mà để kể chuyện</h2>
        <p>Le Hiep Studio là người sáng tạo nội dung số tại Hà Nội, được hơn <strong><%= studio.followers %></strong> người theo dõi tin tưởng. Chúng tôi theo đuổi nhiếp ảnh ý tưởng — nơi trang phục, bối cảnh, ánh sáng và hậu kỳ cùng hoà quyện để tạo nên một tác phẩm, không đơn thuần là một bức ảnh.</p>
        <p>Từ những mái chùa cổ kính, sắc hoa bốn mùa đến hồn cốt văn hoá Việt trong từng thước vải áo dài — mỗi khung hình là một câu chuyện riêng, được kể theo cách riêng của bạn.</p>
        <a href="<%= studio.facebookUrl %>" target="_blank" rel="noopener" class="link-underline">Xem thêm trên Facebook →</a>
      </div>
    </div>
  </section>

  <!-- STYLE PILLARS -->
  <section class="services" id="services">
    <div class="container">
      <p class="eyebrow reveal center">Dấu ấn phong cách</p>
      <h2 class="section-title reveal center">Điều làm nên một bức ảnh Le Hiep</h2>

      <div class="services-grid">
        <% studio.pillars.forEach(function(s, i){ %>
        <div class="service-card reveal" style="--i: <%= i %>">
          <span class="service-index">0<%= i + 1 %></span>
          <h3><%= s.name %></h3>
          <p><%= s.desc %></p>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section class="portfolio" id="portfolio">
    <div class="container">
      <p class="eyebrow reveal center">Portfolio</p>
      <h2 class="section-title reveal center">Một vài khoảnh khắc</h2>
      <p class="section-sub reveal center">Trích từ những bộ ảnh nghệ thuật thực tế của studio.</p>

      <div class="portfolio-grid">
        <% studio.portfolio.forEach(function(p, i){ %>
        <figure class="portfolio-item reveal" style="--i: <%= i %>">
          <img src="/images/portfolio/<%= p.file %>" alt="<%= p.caption %> - Le Hiep Studio" loading="lazy" width="700" height="900">
          <figcaption><%= p.caption %></figcaption>
        </figure>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact" id="contact">
    <div class="container contact-grid">
      <div class="contact-info reveal">
        <p class="eyebrow">Liên hệ</p>
        <h2>Đặt lịch chụp<br>ngay hôm nay</h2>
        <p>Để lại số Zalo, Le Hiep Studio sẽ liên hệ tư vấn và sắp xếp lịch chụp phù hợp nhất cho bạn.</p>

        <ul class="contact-list">
          <li>
            <span>Hotline / Zalo</span>
            <a href="tel:<%= studio.phone %>"><%= studio.phone %></a>
          </li>
          <li>
            <span>Khu vực</span>
            <a>Hà Nội &amp; lân cận</a>
          </li>
          <li>
            <span>Facebook</span>
            <a href="<%= studio.facebookUrl %>" target="_blank" rel="noopener">Le Hiep Studio</a>
          </li>
        </ul>

        <a href="<%= studio.zaloUrl %>" target="_blank" rel="noopener" class="btn btn-primary btn-zalo">
          Nhắn Zalo trực tiếp
        </a>
      </div>

      <form class="contact-form reveal" id="contact-form" novalidate>
        <div class="field">
          <label for="name">Họ và tên <span aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" autocomplete="name" required minlength="2">
        </div>

        <div class="field">
          <label for="phone">Số điện thoại / Zalo <span aria-hidden="true">*</span></label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" required placeholder="09xxxxxxxx">
        </div>

        <div class="field">
          <label for="service">Bạn muốn chụp theo phong cách nào?</label>
          <select id="service" name="service">
            <% studio.inquiryOptions.forEach(function(o){ %>
            <option value="<%= o %>"><%= o %></option>
            <% }); %>
          </select>
        </div>

        <div class="field">
          <label for="message">Lời nhắn (không bắt buộc)</label>
          <textarea id="message" name="message" rows="3" maxlength="1000"></textarea>
        </div>

        <!-- honeypot chống bot, an voi nguoi dung that -->
        <div class="field field-hidden" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
        </div>

        <button type="submit" class="btn btn-primary btn-block" id="submit-btn">Gửi thông tin</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</main>

<%- include('partials/footer') %>

<script src="/js/main.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
